# Copy to .env.deploy.local (ignored by Git), or set these in Workers Builds.
PUBLIC_ORIGIN=https://vpn.example.com
WORKER_NAME=family-access
SITE_NAME="Family Access"
# RP_ID defaults to the PUBLIC_ORIGIN hostname.
# RP_ID=vpn.example.com
# Keep FAMILY_ID stable after first use: it selects the object's database.
FAMILY_ID=family-v1
SESSION_COOKIE_NAME=family_session
SESSION_TTL_SECONDS=604800
INVITE_TTL_SECONDS=86400
SETUP_INVITE_TTL_SECONDS=3600
CHALLENGE_TTL_SECONDS=300
# ADMIN_SETUP_SECRET is a Worker secret, not a build variable or config value.

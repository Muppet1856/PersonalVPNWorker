{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-access",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "vars": {
    "PUBLIC_ORIGIN": "http://localhost:8787",
    "RP_ID": "localhost",
    "SITE_NAME": "Family Access",
    "FAMILY_ID": "family-v1"
  },
  "routes": [],
  "env": {
    "local": {
      "name": "family-access-local",
      "workers_dev": false,
      "routes": [],
      "vars": {
        "PUBLIC_ORIGIN": "http://localhost:8787",
        "RP_ID": "localhost",
        "SITE_NAME": "Family Access",
        "FAMILY_ID": "family-v1"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "FAMILY_AUTH",
            "class_name": "FamilyAuth"
          }
        ]
      }
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FAMILY_AUTH",
        "class_name": "FamilyAuth"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "FamilyAuth"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  }
}
